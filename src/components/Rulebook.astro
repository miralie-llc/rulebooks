---
import Base from "../layouts/Base.astro";
import {
  model,
  isPreview,
  content,
  record,
  gameEditions,
  gameUrl,
  editionUrl,
  downloadUrl,
  tagLabel,
  citedSources,
  formalizations,
} from "../lib/catalog.mjs";
const { game, edition, pinned = false } = Astro.props;
const available = gameEditions(game);
const citations = citedSources(edition);
const mappings = formalizations(edition);
const family = game.family ? record("GameFamily", game.family) : null;
const publisher = game.publisherEdition
  ? record("PublisherEdition", game.publisherEdition)
  : null;
const profileCount = new Set(available.map((e) => e.id)).size;
let ruleNumber = 0;
---

<Base
  title={`${game.title} — ${edition.label} | RuleBooks`}
  description={edition.scope.summary}
>
  <div class="reader shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/#library">The library</a><span aria-hidden="true">/</span>{
        pinned ? (
          <>
            <>
              <a href={gameUrl(game)}>{game.title}</a>
              <span aria-hidden="true">/</span>
              <span>Revision {edition.revision}</span>
            </>
          </>
        ) : (
          <span>{game.title}</span>
        )
      }
    </nav>
    <header class="reader-header">
      <div>
        <p class="eyebrow">
          {game.tags?.map(tagLabel).join(" · ") || "GAME RULES"}
        </p><h1>{game.title}</h1><p class="reader-deck">
          {edition.scope.summary}
        </p><div class="reading-badges">
          <span
            class:list={[
              "badge",
              edition.readingStatus === "partial"
                ? "badge-amber"
                : "badge-green",
            ]}
            >{
              edition.readingStatus === "complete"
                ? "Complete within this scope"
                : "Partial guide"
            }</span
          ><span class="badge"
            >{isPreview ? "Editorial draft" : "Reviewed edition"}</span
          >
        </div>
      </div><div class="edition-panel">
        <span class="eyebrow">YOU ARE READING</span><strong
          >{edition.label}</strong
        ><a href={editionUrl(edition)}
          >RuleBooks revision {edition.revision}
          <span aria-hidden="true">↗</span></a
        >{publisher && <p>Publisher edition: {publisher.label}</p>}<label
          for="edition-select">Choose a profile or revision</label
        ><select id="edition-select" aria-label="Choose a profile or revision"
          >{
            available.map((e) => (
              <option
                value={editionUrl(e)}
                selected={
                  e.id === edition.id && e.revision === edition.revision
                }
              >
                {e.label} · revision {e.revision}
              </option>
            ))
          }</select
        >
      </div>
    </header>
    {
      isPreview && (
        <aside class="draft-notice" aria-label="Editorial status">
          <strong>Editorial draft.</strong> Written from the sources below; not
          yet accepted as a reviewed release.{" "}
          <a href="/about/#editorial-status">What this means ↗</a>
        </aside>
      )
    }
    {
      edition.readingStatus === "partial" && (
        <aside class="scope-warning">
          <strong>
            This is an introduction, not a complete playing guide.
          </strong>{" "}
          Read the <a href="#scope">scope and omissions</a> before relying on it
          for a full game.
        </aside>
      )
    }
    <div class="reading-layout">
      <aside class="reading-sidebar">
        <nav aria-label="On this page">
          <p class="eyebrow">ON THIS PAGE</p><ol>
            {
              edition.sections.map((s, index) => (
                <li>
                  <a href={`#${s.id}`}>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    {s.title}
                  </a>
                </li>
              ))
            }
          </ol><a href="#scope">Scope &amp; limitations</a><a href="#sources"
            >Sources</a
          ><a href="#versions">Profiles &amp; revisions</a><a
            href="#representation">Structured representation</a
          >
        </nav><a class="download-link" href={downloadUrl(edition)} download
          >Download this rulebook <span
            >JSON <span aria-hidden="true">↓</span></span
          ></a
        >
      </aside>
      <article class="rulebook-content" aria-label={`${game.title} rules`}>
        {
          edition.sections.map((section, index) => (
            <section class="rule-section" id={section.id}>
              <>
                <div class="rule-section-heading">
                  <>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <h2>{section.title}</h2>
                  </>
                </div>
                <ol class="rules">
                  {section.rules.map((rule) => {
                    const origin = rule.origin || edition.origin;
                    const number = ++ruleNumber;
                    return (
                      <li id={`rule-${rule.id}`}>
                        <p class="rule-statement">{rule.statement}</p>
                        <div class="rule-attribution">
                          {model.ruleConcepts(edition, rule.id).map((link) => (
                            <a href={link.href}>
                              {link.concept.title} · BGSM {link.mapping.bgsm} ·{" "}
                              {link.status}
                            </a>
                          ))}
                          <a
                            class="rule-permalink"
                            href={`${editionUrl(edition)}#rule-${rule.id}`}
                            aria-label={`Permanent link to rule ${number}: ${rule.id}`}
                          >
                            § {String(number).padStart(2, "0")}
                          </a>
                          {origin.kind === "source" ? (
                            origin.citations.map((citation) => {
                              const source = record("Source", citation.source);
                              return (
                                <a
                                  href={`#source-${source.id}-${source.revision}`}
                                >
                                  {source.author || source.title} ·{" "}
                                  {citation.locator}
                                </a>
                              );
                            })
                          ) : (
                            <details class="editorial-attribution">
                              <summary>Editorial choice</summary>
                              <p>{origin.attribution}</p>
                            </details>
                          )}
                        </div>
                      </li>
                    );
                  })}
                </ol>
              </>
            </section>
          ))
        }
        <section id="scope" class="detail-section">
          <p class="eyebrow">THE BOUNDARY OF THIS GUIDE</p><h2>
            Scope &amp; limitations
          </h2><h3>Included</h3><ul>
            {edition.scope.includes.map((value) => <li>{value}</li>)}
          </ul><h3>Not covered</h3><ul>
            {edition.scope.excludes.map((value) => <li>{value}</li>)}
          </ul>
        </section>
        <section id="sources" class="detail-section">
          <p class="eyebrow">WHERE THE RULES COME FROM</p><h2>Sources</h2>{
            citations.length ? (
              citations.map((source) => (
                <div
                  class="source-card"
                  id={`source-${source.id}-${source.revision}`}
                >
                  <>
                    <span class="eyebrow">{source.author || "REFERENCE"}</span>
                    <h3>
                      <a href={source.url}>
                        {source.title} <span aria-hidden="true">↗</span>
                      </a>
                    </h3>
                    <p>
                      Source edition: {source.edition.label || "Not identified"}
                    </p>
                    <small>
                      Accessed {source.accessed} · Source record revision{" "}
                      {source.revision}
                    </small>
                    <a
                      class="text-link"
                      href={`/sources/${source.id}/${source.revision}/`}
                    >
                      View source record
                    </a>
                  </>
                </div>
              ))
            ) : (
              <p>
                This profile is an original editorial definition. Attribution
                accompanies its rules.
              </p>
            )
          }<p class="small-note">
            Source editions identify the documents. RuleBooks revisions identify
            our records. A source date does not create a publisher edition of
            the game.
          </p>
        </section>
        <section id="versions" class="detail-section">
          <p class="eyebrow">PIN THE RULES YOU MEAN</p><h2>
            Profiles &amp; revisions
          </h2><p>
            {
              profileCount === 1
                ? "One rules profile is available."
                : `${profileCount} rules profiles are available for this game.`
            } Each link identifies an exact record revision.
          </p><ul class="version-list">
            {
              available.map((e) => (
                <li>
                  <a href={editionUrl(e)}>
                    {e.label}
                    <span>
                      Revision {e.revision}{" "}
                      {e.id === edition.id && e.revision === edition.revision
                        ? "· You are here"
                        : "↗"}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>{
            family && (
              <p class="family-link">
                Part of the{" "}
                <a href={`/families/${family.id}/`}>{family.title} family →</a>
              </p>
            )
          }
        </section>
        <section id="representation" class="detail-section representation">
          <p class="eyebrow">FOR A CLOSER LOOK</p><h2>
            Structured representation
          </h2>{
            mappings.length ? (
              <>
                <p>
                  {mappings.length} formalization record
                  {mappings.length === 1 ? "" : "s"} for this exact edition.
                  Mapping coverage does not establish executable verification.
                </p>
                {mappings.map((mapping) => (
                  <details>
                    <summary>
                      {mapping.id} · revision {mapping.revision}
                    </summary>
                    <p>
                      BGSM {mapping.bgsm} · {mapping.language.id}{" "}
                      {mapping.language.version}
                    </p>
                    <ul>
                      {mapping.coverage.map((row) => (
                        <li>
                          {row.rule}: {row.status}
                          {row.reason ? ` — ${row.reason}` : ""}
                        </li>
                      ))}
                    </ul>
                    <a href={downloadUrl(mapping)}>
                      Download formalization record
                    </a>
                  </details>
                ))}
              </>
            ) : (
              <p>
                <strong>Not yet formalized.</strong> This guide has readable
                rules and structured records, but no BGSM mapping or executable
                verification.
              </p>
            )
          }<a class="text-link" href={downloadUrl(edition)} download
            >Download readable-rule data ↗</a
          >
        </section>
      </article>
    </div>
  </div>
</Base>
<script>
  document
    .querySelector<HTMLSelectElement>("#edition-select")
    ?.addEventListener("change", (event) => {
      const value = (event.target as HTMLSelectElement).value;
      if (value.startsWith("/editions/")) window.location.assign(value);
    });
</script>
