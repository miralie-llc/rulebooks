---
import Base from "../layouts/Base.astro";
import GameArt from "../components/GameArt.astro";
import GameCard from "../components/GameCard.astro";
import { games, editions, isPreview } from "../lib/catalog.mjs";
const featured = games[0];
const profileCount = new Set(editions.map((e) => e.id)).size;
---

<Base>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="tiny-square"></span> A LIVING LIBRARY OF GAMES
      </p><h1>Every game starts<br />with <em>its rules.</em></h1><p
        class="hero-description"
      >
        Find the rules. Understand the details.<br />See where they come from.
      </p><a href="#library" class="primary-link"
        >Explore the library <span aria-hidden="true">↓</span></a
      ><div class="hero-meta">
        <span>{games.length} games</span><span
          >{profileCount} rulebook profiles</span
        ><span>Sources included</span>
      </div>
    </div>
    <div class="hero-object">
      <div class="folio">
        <div class="folio-top">
          <span>FROM THE LIBRARY</span><span>001</span>
        </div><GameArt gameId={featured.id} hero /><div class="folio-bottom">
          <span>{featured.title}</span><span
            >{
              featured.id === "nim-normal-play" ? (
                <>
                  A few counters.
                  <br />A world of possibilities.
                </>
              ) : (
                <>
                  A game to discover.
                  <br />
                  Rules to explore.
                </>
              )
            }</span>
        </div>
      </div><p class="object-caption">Small games. Interesting rules.</p>
    </div>
  </section>
  <section id="library" class="library shell" aria-labelledby="library-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">THE COLLECTION</p><h2 id="library-heading">
          Find your next game.
        </h2>
      </div><p>
        Readable rules, with the details <br />there when you need them.
      </p>
    </div>
    <div class="library-tools">
      <label class="search-field"
        ><span aria-hidden="true">⌕</span><span class="sr-only"
          >Search games</span
        ><input
          id="game-search"
          type="search"
          placeholder="Search by game or style…"
          autocomplete="off"
        /></label
      ><div class="filters" role="group" aria-label="Reading coverage">
        <button type="button" data-filter="all" aria-pressed="true"
          >All games</button
        ><button type="button" data-filter="complete" aria-pressed="false"
          >Complete guides</button
        ><button type="button" data-filter="partial" aria-pressed="false"
          >Partial guides</button>
      </div><span id="result-count" class="result-count" aria-live="polite"
        >{games.length} games</span>
    </div>
    <div class="game-grid">
      {games.map((game, index) => <GameCard game={game} number={index + 1} />)}
    </div>
    <div id="no-results" class="empty-state" hidden>
      <h3>No games found.</h3><p>
        Try another name or clear the reading-coverage filter.
      </p><button type="button" id="reset-search">Show all games</button>
    </div>
    {
      isPreview && (
        <p class="catalog-note">
          <span class="status-dot" /> First collection · These guides are
          editorial drafts. Completeness describes their stated scope, not
          review approval.
        </p>
      )
    }
  </section>
  <section class="library-principles shell">
    <div>
      <p class="eyebrow">MORE THAN A RULE SUMMARY</p><h2>
        Simple on the surface.<br /><em>Precise underneath.</em>
      </h2>
    </div><div class="principle">
      <span>01 / READ</span><h3>Start with how to play.</h3><p>
        Setup, turns and outcomes in a clear reading order. Each guide tells you
        exactly what it covers.
      </p>
    </div><div class="principle">
      <span>02 / TRACE</span><h3>Follow the source.</h3><p>
        Rules link to their sources. Editorial choices and gaps stay visible, so
        you can explore further.
      </p>
    </div>
  </section>
</Base>
<script>
  const input = document.querySelector<HTMLInputElement>("#game-search")!;
  const cards = [...document.querySelectorAll<HTMLElement>("[data-game-card]")];
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-filter]"),
  ];
  let filter = "all";
  const update = () => {
    const query = input.value.trim().toLowerCase();
    let count = 0;
    for (const card of cards) {
      const visible =
        (filter === "all" || card.dataset.completeness === filter) &&
        (card.dataset.search || "").includes(query);
      card.hidden = !visible;
      if (visible) count++;
    }
    document.querySelector("#result-count")!.textContent =
      `${count} ${count === 1 ? "game" : "games"}`;
    (document.querySelector("#no-results") as HTMLElement).hidden = count !== 0;
    for (const button of buttons)
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.filter === filter),
      );
  };
  input.addEventListener("input", update);
  buttons.forEach((button) =>
    button.addEventListener("click", () => {
      filter = button.dataset.filter!;
      update();
    }),
  );
  document.querySelector("#reset-search")?.addEventListener("click", () => {
    input.value = "";
    filter = "all";
    update();
    input.focus();
  });
</script>
