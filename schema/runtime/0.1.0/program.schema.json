{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuleBooks reference program 0.1.0 (experimental)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "language", "bgsm", "library", "capabilities", "players", "initial", "actions", "outcome", "sourceMap"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "language": {"const": {"id": "rulebooks-json", "version": "0.1.0"}},
    "bgsm": {"const": "0.1.0-draft.1"},
    "library": {"const": {"id": "core", "version": "0.1.0"}},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["finite-intents", "public-state", "deterministic-reduction", "exact-chance"]}},
    "players": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "initial": {"type": "object", "minProperties": 1, "maxProperties": 32, "propertyNames": {"pattern": "^[a-z][a-zA-Z0-9]*$"}},
    "actions": {"type": "array", "minItems": 1, "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "parameters", "legal", "resolve", "effects"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "parameters": {"type": "object", "maxProperties": 4, "propertyNames": {"pattern": "^[a-z][a-zA-Z0-9]*$"}, "additionalProperties": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true}},
        "legal": {}, "resolve": {},
        "effects": {"type": "object", "minProperties": 1, "maxProperties": 32}
      }
    }},
    "outcome": {},
    "sourceMap": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {
      "type": "object", "additionalProperties": false, "required": ["node", "rule"],
      "properties": {"node": {"type": "string", "pattern": "^/"}, "rule": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}}
    }}
  }
}
