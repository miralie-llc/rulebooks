    {
      "kind": "RulebookEdition",
      "id": "rps-single-round",
      "revision": 1,
      "testOnly": true,
      "gameId": "rock-paper-scissors",
      "label": "Single-round RPS — contract fixture",
      "scope": {
        "summary": "Two-player rock-paper-scissors, one simultaneous round; equal choices end in a draw.",
        "includes": [
          "One concealed commitment per player",
          "Reveal only after both choices are fixed",
          "One round with a win, loss or draw"
        ],
        "excludes": [
          "Best-of matches and replaying ties",
          "Gesture timing disputes and adjudication"
        ]
      },
      "dimensions": [
        "game"
      ],
      "readingStatus": "complete",
      "sections": [
        {
          "id": "choice",
          "title": "Commit and reveal",
          "rules": [
            {
              "id": "choices",
              "statement": "Each of two players chooses exactly one of rock, paper or scissors."
            },
            {
              "id": "commitment",
              "statement": "Each player fixes their choice without learning the other choice; a committed choice cannot be changed."
            },
            {
              "id": "reveal",
              "statement": "Reveal both choices only after both players have committed."
            }
          ]
        },
        {
          "id": "result",
          "title": "Resolve and stop",
          "rules": [
            {
              "id": "dominance",
              "statement": "Rock defeats scissors, scissors defeats paper, and paper defeats rock."
            },
            {
              "id": "tie",
              "statement": "Equal choices produce a draw."
            },
            {
              "id": "ending",
              "statement": "The round ends after the reveal with a winner and loser or a draw. A draw does not start another round."
            }
          ]
        }
      ],
