    {
      "kind": "RulebookEdition",
      "id": "nim-one-two",
      "revision": 1,
      "testOnly": true,
      "gameId": "nim-normal-play",
      "label": "Normal-play Nim [1, 2] — contract fixture",
      "scope": {
        "summary": "Two-player normal-play Nim with two heaps initially containing one and two counters.",
        "includes": [
          "Both heaps are visible",
          "Player A moves first",
          "Exactly one heap changes on a turn",
          "Taking the final counter wins"
        ],
        "excludes": [
          "Misère play",
          "Other initial configurations",
          "Clocks and tournament procedures"
        ]
      },
      "dimensions": [
        "game"
      ],
      "readingStatus": "complete",
      "sections": [
        {
          "id": "setup",
          "title": "Players and setup",
          "rules": [
            {
              "id": "players",
              "statement": "Two players, A and B, can see both heaps throughout play."
            },
            {
              "id": "setup",
              "statement": "Start with heap one containing one counter and heap two containing two counters. Player A moves first."
            }
          ]
        },
        {
          "id": "turns",
          "title": "A turn",
          "rules": [
            {
              "id": "legal-action",
              "statement": "On your turn choose one nonempty heap and remove a positive whole number of counters, no greater than that heap contains."
            },
            {
              "id": "transition",
              "statement": "Subtract the chosen number from the chosen heap and leave the other heap unchanged. An illegal choice leaves the position and player to move unchanged."
            },
            {
              "id": "next-player",
              "statement": "If counters remain after a legal move, the other player takes the next turn."
            }
          ]
        },
        {
          "id": "ending",
          "title": "End of play",
          "rules": [
            {
              "id": "outcome",
              "statement": "A player who removes the final counter wins immediately. There are no further turns or drawn outcomes."
            }
          ]
        }
      ],
      "review": {
